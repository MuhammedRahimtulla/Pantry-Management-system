<?xml version="1.0" encoding="utf-8"?>
<!-- Settings screen definition. Keys must match the constants in util/Prefs.java. -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_category_expiry">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="expiry_highlight"
            app:summary="@string/pref_expiry_highlight_summary"
            app:title="@string/pref_expiry_highlight_title" />

        <ListPreference
            app:defaultValue="3"
            app:dependency="expiry_highlight"
            app:entries="@array/expiry_window_labels"
            app:entryValues="@array/expiry_window_values"
            app:key="expiry_window_days"
            app:title="@string/pref_expiry_window_title"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_matching">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="exclude_expired"
            app:summary="@string/pref_exclude_expired_summary"
            app:title="@string/pref_exclude_expired_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_units">

        <ListPreference
            app:defaultValue="pcs"
            app:entries="@array/unit_labels"
            app:entryValues="@array/unit_values"
            app:key="default_unit"
            app:title="@string/pref_default_unit_title"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_data">

        <Preference
            app:key="clear_pantry"
            app:summary="@string/pref_clear_pantry_summary"
            app:title="@string/pref_clear_pantry_title" />

        <Preference
            app:selectable="false"
            app:summary="@string/pref_about_summary"
            app:title="@string/pref_about_title" />
    </PreferenceCategory>

</PreferenceScreen>
